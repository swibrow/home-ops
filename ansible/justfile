# Ansible management for plain (non-Talos) Linux hosts.
# Secrets are SOPS-encrypted with the repo age key (SOPS_AGE_KEY_FILE from the root justfile).

# Install required Ansible collections
deps:
    ansible-galaxy collection install -r requirements.yaml

# Ping the nut host over SSH
ping:
    ansible nut -m ping

# Dry-run the full nut playbook (network + NUT) and show a diff
check:
    ansible-playbook playbooks/site.yaml --check --diff

# Apply the full nut playbook (network + NUT)
deploy:
    ansible-playbook playbooks/site.yaml

# Apply only the NUT role
deploy-nut:
    ansible-playbook playbooks/nut.yaml

# Gather and print facts for the nut host
facts:
    ansible nut -m setup

# Ping the ovh-vps host over SSH
ping-ovh-vps:
    ansible ovh_vps -m ping

# Dry-run the ovh-vps playbook (fail2ban + oha + towonel-hub) and show a diff
check-ovh-vps:
    ansible-playbook playbooks/ovh-vps.yaml --check --diff

# Apply the ovh-vps playbook (fail2ban + oha + towonel-hub)
deploy-ovh-vps:
    ansible-playbook playbooks/ovh-vps.yaml

# Gather and print facts for the ovh-vps host
facts-ovh-vps:
    ansible ovh_vps -m setup

# Ping the homeassistant HAOS host over developer SSH (raw - HAOS has no python)
ping-homeassistant:
    ansible haos -m raw -a 'uname -a'

# Dry-run the homeassistant playbook (PoE fan thresholds) and show pending state
check-homeassistant:
    ansible-playbook playbooks/homeassistant.yaml --check --diff

# Apply the homeassistant playbook (PoE fan thresholds; host reboot required after)
deploy-homeassistant:
    ansible-playbook playbooks/homeassistant.yaml

# Move HAOS onto the tagged iot VLAN 101 (no automatic rollback - recover from
# the HA UI's Network page if it breaks. A "connection lost" result is expected;
# pass the host's current untagged address on the cutover run, e.g.
# `just ansible::apply-network-homeassistant 192.168.0.155`.)
apply-network-homeassistant host='':
    ansible-playbook playbooks/homeassistant-network.yaml {{ if host == '' { '' } else { '-e ansible_host=' + host } }}
