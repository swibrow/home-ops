---
import "@fontsource-variable/bricolage-grotesque/standard.css";
import "@fontsource-variable/atkinson-hyperlegible-next/index.css";
import favicon from "../../../public/favicon.svg?raw";
import "../../styles/global.css";
import EditButton from "../../components/EditButton.astro";
import Horizon from "../../components/Horizon.astro";
import Measured from "../../components/Measured.astro";
import Reload from "../../components/Reload.astro";
import ReloadButton from "../../components/ReloadButton.astro";
import SkyScene from "../../components/SkyScene.astro";
import Weather from "../../components/Weather.astro";
import Calendar from "../../components/widgets/Calendar.astro";
import Cameras from "../../components/widgets/Cameras.astro";
import Coming from "../../components/widgets/Coming.astro";
import Dinner from "../../components/widgets/Dinner.astro";
import Lights from "../../components/widgets/Lights.astro";
import Meals from "../../components/widgets/Meals.astro";
import Photos from "../../components/widgets/Photos.astro";
import "../../components/widgets/panel.css";
import Shopping from "../../components/widgets/Shopping.astro";
import { loadUpcoming } from "../../integrations/arr";
import { loadEvents, loadHome, loadShopping } from "../../integrations/homeassistant";
import { loadOnThisDay } from "../../integrations/immich";
import { loadMeals } from "../../integrations/mealie";
import { settle } from "../../lib/cache";
import { config } from "../../lib/config";
import { arrange, loadLayout, sizeOf } from "../../lib/layout";
import { sky } from "../../lib/sky";
import { format } from "../../lib/time";
import { sizes, widgets, type WidgetId } from "../../lib/widgets";

const layout = await loadLayout();
const placed = new Set(layout.pages.flatMap((p) => p.widgets));

const [home, meals, upcoming, shopping, events, photos] = await Promise.all([
  settle("homeassistant", loadHome()),
  settle("mealie", placed.has("dinner") || placed.has("meals") ? loadMeals() : undefined),
  settle("arr", placed.has("coming") ? loadUpcoming() : undefined),
  settle("shopping", placed.has("shopping") ? loadShopping() : undefined),
  settle("calendar", placed.has("calendar") ? loadEvents() : undefined),
  settle("immich", placed.has("photos") ? loadOnThisDay() : undefined),
]);

const now = new Date();
const colours = sky(home?.sunElevation);
const time = format(now, { hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
const shows: Record<WidgetId, boolean> = {
  dinner: true,
  shopping: !!shopping,
  lights: !!home?.actions.length,
  calendar: !!events,
  coming: !!upcoming?.length,
  meals: !!meals,
  photos: !!photos?.length,
  cameras: !!config.frigate?.cameras.length,
};
const pageOf = Object.fromEntries(layout.pages.flatMap((p) => p.widgets.map((w) => [w, p])));
const areas = Object.fromEntries(
  layout.pages.flatMap((p) => {
    const visible = p.widgets.filter((id) => shows[id]);
    const packed = arrange(visible.map((id) => sizeOf(layout, id)));
    return visible.map((id, i) => [id, packed[i]]);
  }),
);

const appVersion = process.env.APP_VERSION ?? "dev";

Astro.response.headers.set("Cache-Control", "no-store");
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Kitchen" />
    <link rel="manifest" href="/kitchen/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/kitchen/icon-180.png" />
    <meta name="theme-color" content={colours.top} />
    <title>Kitchen</title>
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent(favicon)}`} type="image/svg+xml" />
    <Reload src="/kitchen/api/version" />
  </head>
  <body>
    <div id="live">
      <header class="sky" data-ink={colours.ink} style={`--sky-top:${colours.top};--sky-bottom:${colours.bottom}`}>
        <SkyScene />
        <ReloadButton />
        <EditButton />
        <div class="sky-inner">
          <time class="clock" data-timezone={config.timezone}>{time}</time>
          <div class="day">
            <p class="date">{format(now, { weekday: "long", day: "numeric", month: "long" })}</p>
            {
              home?.weather && (
                <button type="button" class="weather" data-open="weather-details">
                  <span class="temp">
                    {home.weather.temperature}°{home.weather.measured && <Measured />}
                  </span>
                  {home.weather.condition}
                  {home.weather.high !== undefined && `, up to ${home.weather.high}°`}
                  {!!home.weather.rain && `, ${home.weather.rain} mm rain`}
                </button>
              )
            }
          </div>
          <ul class="timers" aria-label="Alexa timers">
            {home?.timers.map((t) => (
              <li>
                <time class="left" datetime={t.ends} />
                <span>{t.name}</span>
              </li>
            ))}
          </ul>
        </div>
        <Horizon />
        <nav class="tabs" aria-label="Pages" data-count={layout.pages.length}>
        {
          layout.pages.map((page, i) => (
            <button type="button" data-goto={i} aria-current={i === 0 ? "true" : "false"}>
              {page.name}
            </button>
          ))
        }
        <button type="button" class="edit-only" data-edit="add-page">Add page</button>
        <button type="button" class="edit-only done" data-edit="toggle">Done</button>
        <p class="edit-status edit-only" role="status"></p>
        </nav>
      </header>

      <main class="pages">
        {
          layout.pages.map((page) => (
            <section class="page" aria-label={page.name}>
              <form class="page-tools edit-only" data-rename={page.id}>
                <label class="visually-hidden" for={`name-${page.id}`}>
                  Page name
                </label>
                <input id={`name-${page.id}`} name="name" value={page.name} maxlength="24" autocomplete="off" required />
                <button type="button" data-edit="add" data-page={page.id}>
                  Add widget
                </button>
                <button type="button" class="secondary" data-edit="remove-page" data-page={page.id} disabled={layout.pages.length === 1}>
                  Remove page
                </button>
              </form>
              {!page.widgets.length && <p class="quiet empty">Nothing on this page yet. Use the pencil button to add widgets.</p>}
              <div class="grid">
                {page.widgets.map((id, i) => {
                  const widget = widgets.find((w) => w.id === id)!;
                  const area = areas[id];
                  return (
                    <div
                      class="widget"
                      style={area && `--col:${area.col + 1};--row:${area.row + 1};--cols:${area.cols};--rows:${area.rows}`}
                      data-empty={!area || undefined}
                    >
                      <div class="widget-tools edit-only">
                        <strong>{widget.name}</strong>
                        <label class="visually-hidden" for={`size-${id}`}>
                          Size of {widget.name}, columns by rows
                        </label>
                        <select id={`size-${id}`} data-size={id}>
                          {sizes.map((size) => (
                            <option value={size} selected={size === sizeOf(layout, id)}>
                              {size.replace("x", " × ")}
                              {size === "3x3" && ", full page"}
                            </option>
                          ))}
                        </select>
                        <button type="button" data-edit="earlier" data-widget={id} disabled={i === 0} aria-label={`Move ${widget.name} earlier`}>
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M15 5l-7 7 7 7" />
                          </svg>
                        </button>
                        <button
                          type="button"
                          data-edit="later"
                          data-widget={id}
                          disabled={i === page.widgets.length - 1}
                          aria-label={`Move ${widget.name} later`}
                        >
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M9 5l7 7-7 7" />
                          </svg>
                        </button>
                        <button type="button" data-edit="remove" data-widget={id} aria-label={`Remove ${widget.name}`}>
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 6l12 12M18 6L6 18" />
                          </svg>
                        </button>
                      </div>
                      <div class="widget-body">
                        {id === "dinner" && <Dinner meals={meals} />}
                        {id === "shopping" && shopping && <Shopping items={shopping} />}
                        {id === "lights" && !!home?.actions.length && <Lights actions={home.actions} />}
                        {id === "calendar" && events && <Calendar events={events} />}
                        {id === "coming" && !!upcoming?.length && <Coming upcoming={upcoming} />}
                        {id === "meals" && meals && <Meals meals={meals} />}
                        {id === "photos" && !!photos?.length && <Photos photos={photos} />}
                        {id === "cameras" && !!config.frigate?.cameras.length && <Cameras cameras={config.frigate.cameras} />}
                        {!shows[id] && <p class="quiet">Nothing to show right now.</p>}
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          ))
        }
      </main>

      {home?.weather && <Weather id="weather-details" weather={home.weather} />}

      <dialog class="sheet" id="add-widget" aria-labelledby="add-widget-heading">
        <form method="dialog">
          <h2 id="add-widget-heading">Add a widget</h2>
          <ul class="choices">
            {
              widgets.map((w) => (
                <li>
                  <button type="button" data-edit="place" data-widget={w.id} data-on={pageOf[w.id]?.id}>
                    <strong>{w.name}</strong>
                    <span>{w.description}</span>
                    {pageOf[w.id] && <small>Now on {pageOf[w.id].name}, adding it here moves it</small>}
                  </button>
                </li>
              ))
            }
          </ul>
          <div class="actions">
            <button type="button" class="secondary" data-close>
              Cancel
            </button>
          </div>
        </form>
      </dialog>

      <script is:inline type="application/json" id="layout" set:html={JSON.stringify(layout).replace(/</g, "\\u003c")} />
    </div>

    <small class="version">{appVersion}</small>

    <dialog class="camera-view" aria-label="Camera">
      <video muted playsinline autoplay></video>
      <p class="camera-name"></p>
      <form method="dialog">
        <button>Close</button>
      </form>
    </dialog>

    <dialog class="doorbell" aria-labelledby="doorbell-heading">
      <h2 id="doorbell-heading">Someone is at the door</h2>
      {
        config.frigate?.doorbell ? (
          <video data-camera={config.frigate.doorbell} muted playsinline autoplay aria-label="Doorbell camera" />
        ) : (
          <img alt="Doorbell camera" />
        )
      }
      <form method="dialog">
        {config.homeAssistant.doorbell?.unlock && <button type="button" class="unlock">Open the door</button>}
        <button autofocus>Close</button>
      </form>
    </dialog>

    <script>
      const clock = () => {
        const el = document.querySelector<HTMLTimeElement>(".clock");
        if (!el) return;
        el.textContent = new Intl.DateTimeFormat("en-GB", {
          timeZone: el.dataset.timezone,
          hour: "2-digit",
          minute: "2-digit",
          hourCycle: "h23",
        }).format(new Date());
      };
      setInterval(clock, 10_000);

      const timers = () => {
        for (const el of document.querySelectorAll<HTMLTimeElement>(".timers time")) {
          const left = Math.ceil((Date.parse(el.dateTime) - Date.now()) / 1000);
          const [h, m, s] = [Math.floor(left / 3600), Math.floor(left / 60) % 60, left % 60];
          const pad = (n: number) => String(n).padStart(2, "0");
          el.textContent = left <= 0 ? "Done" : h ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
          el.parentElement!.classList.toggle("ringing", left <= 0);
        }
      };
      timers();
      setInterval(timers, 1_000);

      setInterval(async () => {
        try {
          const res = await fetch("/kitchen/api/timers", { cache: "no-store" });
          const list = document.querySelector(".timers");
          if (!res.ok || !list) return;
          const items: { name: string; ends: string }[] = await res.json();
          list.replaceChildren(
            ...items.map((t) => {
              const li = document.createElement("li");
              const left = Object.assign(document.createElement("time"), { className: "left", dateTime: t.ends });
              li.append(left, Object.assign(document.createElement("span"), { textContent: t.name }));
              return li;
            }),
          );
          timers();
        } catch {}
      }, 10_000);

      const pager = () => document.querySelector<HTMLElement>(".pages");
      const pageIndex = () => {
        const el = pager();
        return el?.clientWidth ? Math.round(el.scrollLeft / el.clientWidth) : 0;
      };
      const goTo = (index: number, smooth = true) => {
        const el = pager();
        el?.scrollTo({ left: index * el.clientWidth, behavior: smooth ? "smooth" : "auto" });
      };
      const markPage = () => {
        const index = pageIndex();
        document.querySelectorAll("[data-goto]").forEach((b, i) => b.setAttribute("aria-current", String(i === index)));
      };
      document.addEventListener("scroll", (event) => (event.target as Element).classList?.contains("pages") && markPage(), true);

      const editing = () => document.body.classList.contains("editing");
      const setEditing = (on: boolean) => {
        document.body.classList.toggle("editing", on);
        document.querySelector(".edit-toggle")?.setAttribute("aria-pressed", String(on));
      };

      // Live camera feeds over WebRTC from Frigate's go2rtc, connected only while on screen.
      const feeds = new Map<HTMLVideoElement, RTCPeerConnection>();
      const hangUp = (video: HTMLVideoElement) => {
        feeds.get(video)?.close();
        feeds.delete(video);
        video.srcObject = null;
      };
      const watch = async (video: HTMLVideoElement) => {
        const pc = new RTCPeerConnection();
        feeds.set(video, pc);
        pc.addTransceiver("video", { direction: "recvonly" });
        pc.ontrack = (event) => {
          video.srcObject = event.streams[0] ?? new MediaStream([event.track]);
          video.play().catch(() => {});
        };
        pc.onconnectionstatechange = () => {
          if (pc.connectionState === "failed" || pc.connectionState === "disconnected") hangUp(video);
        };
        try {
          await pc.setLocalDescription(await pc.createOffer());
          await new Promise<void>((done) => {
            pc.onicegatheringstatechange = () => pc.iceGatheringState === "complete" && done();
            setTimeout(done, 2000);
          });
          const res = await fetch(`/kitchen/api/camera/${video.dataset.camera}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ sdp: pc.localDescription!.sdp }),
          });
          if (!res.ok) throw new Error(`camera ${video.dataset.camera} returned ${res.status}`);
          if (feeds.get(video) === pc) await pc.setRemoteDescription({ type: "answer", sdp: await res.text() });
        } catch {
          if (feeds.get(video) === pc) hangUp(video);
        }
      };
      const onScreen = (el: Element) => {
        const r = el.getBoundingClientRect();
        return !document.hidden && r.width > 0 && r.right > 1 && r.left < innerWidth - 1 && r.bottom > 0 && r.top < innerHeight;
      };
      setInterval(() => {
        feeds.forEach((_, v) => (!v.isConnected || !onScreen(v)) && hangUp(v));
        document.querySelectorAll<HTMLVideoElement>("video[data-camera]").forEach((v) => !feeds.has(v) && onScreen(v) && watch(v));
      }, 1_000);

      const viewer = document.querySelector<HTMLDialogElement>(".camera-view")!;
      const viewed = viewer.querySelector("video")!;
      document.addEventListener("click", (event) => {
        const tile = (event.target as Element).closest<HTMLElement>("[data-view]");
        if (!tile || editing()) return;
        hangUp(viewed);
        viewed.dataset.camera = tile.dataset.view;
        viewer.querySelector(".camera-name")!.textContent = tile.dataset.label ?? "";
        viewer.showModal();
      });
      viewer.addEventListener("click", () => viewer.close());

      const refresh = async (force = false) => {
        if (!force && (editing() || document.querySelector("#live input:focus, #live dialog[open]"))) return;
        try {
          const res = await fetch(location.pathname, { cache: "no-store" });
          if (!res.ok) return;
          const next = new DOMParser().parseFromString(await res.text(), "text/html");
          const index = pageIndex();
          // Playing feeds move into the new page so the refresh doesn't restart them.
          const playing = new Map([...feeds.keys()].map((v) => [v.dataset.camera, v]));
          next.querySelectorAll<HTMLVideoElement>("#live video[data-camera]").forEach((v) => {
            const old = playing.get(v.dataset.camera);
            if (old) v.replaceWith(old);
          });
          document.querySelector("#live")!.replaceWith(next.querySelector("#live")!);
          feeds.forEach((_, v) => v.play().catch(() => {}));
          goTo(index, false);
          markPage();
          setEditing(editing());
          clock();
          timers();
        } catch {}
      };
      setInterval(() => refresh(), 60_000);

      let lastInput = Date.now();
      for (const type of ["pointerdown", "touchstart", "keydown", "wheel"])
        document.addEventListener(type, () => (lastInput = Date.now()), { capture: true, passive: true });
      setInterval(() => {
        if (Date.now() - lastInput < 5 * 60_000) return;
        if (editing()) {
          document.querySelector<HTMLDialogElement>("#add-widget")?.close();
          setEditing(false);
        }
        if (pageIndex() !== 0) goTo(0);
        if (viewer.open) viewer.close();
      }, 10_000);

      type Layout = { pages: { id: string; name: string; widgets: string[] }[]; sizes?: Record<string, string> };
      const save = async (change: (pages: Layout["pages"], layout: Layout) => Layout["pages"] | void) => {
        const layout: Layout = JSON.parse(document.getElementById("layout")!.textContent!);
        layout.pages = change(layout.pages, layout) ?? layout.pages;
        const status = document.querySelector(".edit-status")!;
        status.textContent = "Saving…";
        const res = await fetch("/kitchen/api/layout", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(layout),
        }).catch(() => undefined);
        if (!res?.ok) {
          status.textContent = "Couldn't save, try again";
          return false;
        }
        await refresh(true);
        return true;
      };
      const unplace = (pages: Layout["pages"], widget: string) => pages.forEach((p) => (p.widgets = p.widgets.filter((w) => w !== widget)));

      const edit = async (button: HTMLButtonElement) => {
        const { edit: action, page, widget = "" } = button.dataset;
        const picker = document.querySelector<HTMLDialogElement>("#add-widget")!;
        if (action === "toggle") return setEditing(!editing());
        if (action === "add") {
          picker.dataset.page = page;
          picker.querySelectorAll<HTMLButtonElement>("[data-on]").forEach((b) => (b.disabled = b.dataset.on === page));
          return picker.showModal();
        }
        if (action === "place") {
          picker.close();
          return save((pages) => {
            unplace(pages, widget);
            pages.find((p) => p.id === picker.dataset.page)?.widgets.push(widget);
          });
        }
        if (action === "remove") return save((pages) => unplace(pages, widget));
        if (action === "earlier" || action === "later")
          return save((pages) => {
            const list = pages.find((p) => p.widgets.includes(widget))!.widgets;
            const i = list.indexOf(widget);
            const j = action === "earlier" ? i - 1 : i + 1;
            if (j >= 0 && j < list.length) [list[i], list[j]] = [list[j], list[i]];
          });
        if (action === "add-page") {
          let count = 0;
          const ok = await save((pages) => {
            pages.push({ id: `p${Date.now().toString(36)}`, name: `Page ${pages.length + 1}`, widgets: [] });
            count = pages.length;
          });
          if (ok) goTo(count - 1);
          return;
        }
        if (action === "remove-page") return save((pages) => pages.filter((p) => p.id !== page));
      };

      const rename = (form: HTMLFormElement) => {
        const input = form.querySelector("input")!;
        const name = input.value.trim();
        const layout: Layout = JSON.parse(document.getElementById("layout")!.textContent!);
        const current = layout.pages.find((p) => p.id === form.dataset.rename);
        if (!name) input.value = current?.name ?? "";
        else if (current && name !== current.name)
          save((pages) => {
            pages.find((p) => p.id === form.dataset.rename)!.name = name;
          });
      };
      document.addEventListener("change", (event) => {
        const select = (event.target as Element).closest<HTMLSelectElement>("select[data-size]");
        if (select)
          return save((_, layout) => {
            layout.sizes = { ...layout.sizes, [select.dataset.size!]: select.value };
          });
        const form = (event.target as Element).closest<HTMLFormElement>("form[data-rename]");
        if (form) rename(form);
      });

      const shopping = async (body: object) => {
        const res = await fetch("/kitchen/api/shopping", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (res.ok) await refresh();
        return res.ok;
      };

      document.addEventListener("click", (event) => {
        const go = (event.target as Element).closest<HTMLElement>("[data-goto]");
        if (go) return goTo(Number(go.dataset.goto));
        const editor = (event.target as Element).closest<HTMLButtonElement>("button[data-edit]");
        if (editor) return edit(editor);
        const opener = (event.target as Element).closest<HTMLElement>("[data-open]");
        const sheet = opener && document.getElementById(opener.dataset.open!);
        if (sheet instanceof HTMLDialogElement) {
          sheet.showModal();
          setTimeout(() => sheet.close(), 120_000);
          return;
        }
        const close = (event.target as Element).closest("[data-close]");
        if (close) {
          close.closest("dialog")!.close();
          return;
        }
        const item = (event.target as Element).closest<HTMLButtonElement>("button[data-done]");
        if (!item) return;
        item.classList.add("done");
        item.disabled = true;
        shopping({ done: item.dataset.done }).then((ok) => {
          if (!ok) {
            item.classList.remove("done");
            item.disabled = false;
          }
        });
      });

      document.addEventListener("submit", async (event) => {
        const renamer = (event.target as Element).closest<HTMLFormElement>("form[data-rename]");
        if (renamer) {
          event.preventDefault();
          return renamer.querySelector("input")!.blur();
        }
        const add = (event.target as Element).closest<HTMLFormElement>("form[data-event]");
        if (add) {
          event.preventDefault();
          const submit = add.querySelector<HTMLButtonElement>("button[type='submit']")!;
          submit.disabled = true;
          submit.textContent = "Adding…";
          const res = await fetch("/kitchen/api/calendar", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(Object.fromEntries(new FormData(add))),
          }).catch(() => undefined);
          submit.disabled = false;
          if (!res?.ok) {
            submit.textContent = "Couldn't add, try again";
            return;
          }
          add.closest("dialog")!.close();
          await refresh();
          return;
        }
        const form = (event.target as Element).closest<HTMLFormElement>("form[data-shopping]");
        if (!form) return;
        event.preventDefault();
        const input = form.querySelector("input")!;
        if (!input.value.trim()) return;
        input.disabled = true;
        const ok = await shopping({ add: input.value });
        input.disabled = false;
        if (ok) input.value = "";
        else input.setCustomValidity("Couldn't add that, try again");
      });

      const dialog = document.querySelector<HTMLDialogElement>(".doorbell")!;
      const camera = dialog.querySelector<HTMLImageElement | HTMLVideoElement>("img, video")!;
      let lastRing = 0;
      setInterval(async () => {
        try {
          const { active } = await (await fetch("/kitchen/api/doorbell", { cache: "no-store" })).json();
          if (active) {
            lastRing = Date.now();
            const snapshot = `/kitchen/api/doorbell.jpg?t=${lastRing}`;
            if (camera instanceof HTMLVideoElement) camera.poster = snapshot;
            else camera.src = snapshot;
            if (!dialog.open && !dialog.dataset.dismissed) dialog.showModal();
          } else if (Date.now() - lastRing > 60_000) {
            delete dialog.dataset.dismissed;
            if (dialog.open) dialog.close();
          }
        } catch {}
      }, 4_000);
      const unlock = dialog.querySelector<HTMLButtonElement>(".unlock");
      unlock?.addEventListener("click", async () => {
        unlock.disabled = true;
        unlock.textContent = "Opening…";
        // Astro rejects a POST without a JSON content type as a cross-site form submission.
        const ok = await fetch("/kitchen/api/unlock", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).then(
          (res) => res.ok,
          () => false,
        );
        unlock.textContent = ok ? "Door opened" : "Couldn't open, try again";
        setTimeout(() => {
          unlock.disabled = false;
          unlock.textContent = "Open the door";
        }, 5_000);
      });
      dialog.addEventListener("close", () => {
        if (Date.now() - lastRing < 60_000) dialog.dataset.dismissed = "true";
      });
    </script>
  </body>
</html>

