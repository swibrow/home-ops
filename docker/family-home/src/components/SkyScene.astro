---
import { scene } from "../integrations/comfyui";
import { loadSky, type SkySlot } from "../integrations/homeassistant";
import { settle } from "../lib/cache";

type Props = { slots?: SkySlot[] };
const slots = Astro.props.slots ?? (await settle("sky", loadSky())) ?? [];
---

{
  slots.length > 0 && (
    <div class="scene" style={`--slots:${slots.length}`}>
      {slots.map((s, i) => {
        const file = scene(s.condition, s.daypart);
        return <div class="slot" style={`--i:${i}`}>{file && <img src={`/kitchen/api/scene/${file}`} alt="" />}</div>;
      })}
      {slots.map((s, i) => (
        <span class="label" style={`--i:${i}`} data-ink={s.daypart === "day" ? "dark" : "light"}>
          {s.label} <b>{s.temperature}°</b>
        </span>
      ))}
    </div>
  )
}

<style>
  .scene {
    --fade: 12rem;
    --veil: 12 20 34;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  :global(.sky[data-ink="dark"]) .scene {
    --veil: 240 245 247;
  }

  .slot {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(100% * var(--i) / var(--slots) - var(--fade));
    width: calc(100% / var(--slots) + var(--fade));
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--fade));
    mask-image: linear-gradient(90deg, transparent, #000 var(--fade));
  }

  .slot:first-child {
    left: 0;
    width: calc(100% / var(--slots));
    -webkit-mask-image: none;
    mask-image: none;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }

  /* Leans the scenes behind the clock and date towards the header's own sky, so its ink stays legible. */
  .scene::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(var(--veil) / 0.45), rgb(var(--veil) / 0.25) 45%, rgb(var(--veil) / 0) 75%);
  }

  .label {
    position: absolute;
    z-index: 1;
    top: calc(0.75rem + env(safe-area-inset-top));
    left: calc(100% * var(--i) / var(--slots) + 0.75rem);
    padding: 0.2rem 0.7rem 0.25rem;
    border-radius: 999px;
    background: rgb(12 20 34 / 0.4);
    color: #f4f7f8;
    font-size: 1rem;
    white-space: nowrap;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .label:nth-of-type(1) {
    left: var(--gutter);
  }

  .label[data-ink="dark"] {
    background: rgb(255 255 255 / 0.55);
    color: #16242a;
  }

  .label b {
    font-family: var(--display);
    font-weight: 700;
    margin-left: 0.2rem;
  }
</style>
