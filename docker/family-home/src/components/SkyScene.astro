---
import { scene } from "../integrations/comfyui";
import { loadSky } from "../integrations/homeassistant";
import { settle } from "../lib/cache";
import Measured from "./Measured.astro";

const { slots = [], arc } = (await settle("sky", loadSky())) ?? {};
const angle = Math.PI * Math.min(Math.max(arc?.progress ?? 0, 0), 1);
---

{
  slots.length > 0 && (
    <div class="scene" style={`--slots:${slots.length}`}>
      {slots.map((s, i) => {
        const file = scene(s.condition, s.daypart);
        return <div class="slot" style={`--i:${i}`}>{file && <img src={`/kitchen/api/scene/${file}`} alt="" />}</div>;
      })}
      {arc && (
        <div class="arc" aria-hidden="true">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none">
            <path d="M0 100A50 100 0 0 1 100 100" />
          </svg>
          <span class={arc.body} style={`--x:${(1 - Math.cos(angle)) / 2};--y:${Math.sin(angle)}`} />
        </div>
      )}
      {slots.map((s, i) => (
        <span class="label" style={`--i:${i}`} data-ink={s.daypart === "day" ? "dark" : "light"}>
          {s.label} <b>{s.temperature}°{s.measured && <Measured />}</b> {s.summary}
        </span>
      ))}
    </div>
  )
}

<style>
  .scene {
    --fade: calc(50% / var(--slots));
    --veil: 12 20 34;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  :global(.sky[data-ink="dark"]) .scene {
    --veil: 240 245 247;
  }

  .slot {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(100% * var(--i) / var(--slots) - var(--fade));
    width: calc(100% / var(--slots) + var(--fade));
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 33%);
    mask-image: linear-gradient(90deg, transparent, #000 33%);
  }

  .slot:first-child {
    left: 0;
    width: calc(100% / var(--slots));
    -webkit-mask-image: none;
    mask-image: none;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }

  /* Leans the scenes behind the clock and date towards the header's own sky, so its ink stays legible. */
  .scene::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(var(--veil) / 0.45), rgb(var(--veil) / 0.25) 45%, rgb(var(--veil) / 0) 75%);
  }

  .arc {
    position: absolute;
    inset: 22% 4% 30%;
  }

  .arc svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .arc path {
    fill: none;
    stroke: rgb(255 255 255 / 0.35);
    stroke-width: 2;
    stroke-dasharray: 2 8;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .sun,
  .moon {
    position: absolute;
    left: calc(var(--x) * 100%);
    top: calc((1 - var(--y)) * 100%);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .sun {
    background: #f8d97a;
    box-shadow: 0 0 0 6px rgb(248 217 122 / 0.3), 0 0 2.5rem 0.75rem rgb(248 217 122 / 0.55);
  }

  .moon {
    box-shadow: inset -0.6rem 0.2rem 0 0 #e9eef5;
    filter: drop-shadow(0 0 0.6rem rgb(233 238 245 / 0.5));
  }

  .label {
    position: absolute;
    z-index: 1;
    top: calc(0.75rem + env(safe-area-inset-top));
    left: calc(100% * var(--i) / var(--slots) + 0.75rem);
    padding: 0.2rem 0.7rem 0.25rem;
    border-radius: 999px;
    background: rgb(12 20 34 / 0.4);
    color: #f4f7f8;
    font-size: 1rem;
    white-space: nowrap;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .label:nth-of-type(1) {
    left: var(--gutter);
  }

  .label[data-ink="dark"] {
    background: rgb(255 255 255 / 0.55);
    color: #16242a;
  }

  .label b {
    font-family: var(--display);
    font-weight: 700;
    margin-left: 0.2rem;
  }
</style>
