---
import type { Action } from "../lib/config";

type Props = { actions: (Action & { on: boolean; available: boolean })[]; endpoint: string };
const { actions, endpoint } = Astro.props;
---

<div class="switches" data-endpoint={endpoint}>
  {
    actions.map((a) => (
      <button
        type="button"
        class="switch"
        data-action={a.id}
        data-kind={a.kind}
        aria-pressed={a.kind === "toggle" ? String(a.on) : undefined}
        disabled={!a.available}
      >
        <span class="lamp" aria-hidden="true" />
        <span class="switch-label">{a.label}</span>
        <span class="switch-state">{!a.available ? "Unavailable" : a.kind === "toggle" ? (a.on ? "On" : "Off") : "Turn on"}</span>
      </button>
    ))
  }
</div>

<script>
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("button[data-action]");
    const endpoint = button?.closest<HTMLElement>("[data-endpoint]")?.dataset.endpoint;
    if (!button || !endpoint) return;
    const state = button.querySelector(".switch-state")!;
    const toggle = button.dataset.kind === "toggle";
    const before = button.getAttribute("aria-pressed");
    button.disabled = true;
    if (toggle) {
      const next = before !== "true";
      button.setAttribute("aria-pressed", String(next));
      state.textContent = next ? "On" : "Off";
    }
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: button.dataset.action }),
      });
      if (!res.ok) throw new Error();
      if (!toggle) state.textContent = "Done";
    } catch {
      if (toggle) button.setAttribute("aria-pressed", before ?? "false");
      state.textContent = "Didn't work, try again";
    } finally {
      button.disabled = false;
      if (!toggle) setTimeout(() => (state.textContent = "Turn on"), 3000);
    }
  });
</script>

<style>
  .switches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--switch-min, 9.5rem), 1fr));
    gap: 0.6rem;
  }

  .switch {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.7rem;
    align-items: center;
    text-align: left;
    padding: var(--switch-pad, 0.85rem 0.9rem);
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .switch:hover:not(:disabled) {
    border-color: var(--lake);
  }

  .switch:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .lamp {
    grid-row: span 2;
    width: 0.85em;
    height: 0.85em;
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px var(--muted);
  }

  .switch[aria-pressed="true"] {
    background: color-mix(in srgb, #f2c46d 22%, var(--paper));
    border-color: color-mix(in srgb, #d9a441 60%, var(--rule));
  }

  .switch[aria-pressed="true"] .lamp {
    background: #f2c46d;
    box-shadow: 0 0 0 4px color-mix(in srgb, #f2c46d 35%, transparent);
  }

  .switch-label {
    font-weight: 700;
    line-height: 1.2;
  }

  .switch-state {
    font-size: 0.85em;
    color: var(--muted);
  }
</style>
