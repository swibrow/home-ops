---
import type { loadHome } from "../integrations/homeassistant";
import { format } from "../lib/time";

type Props = { id: string; weather: NonNullable<NonNullable<Awaited<ReturnType<typeof loadHome>>>["weather"]> };
const { id, weather } = Astro.props;
---

<dialog class="weather-details" {id} aria-labelledby="weather-heading">
  <div class="head">
    <h2 id="weather-heading">Weather today</h2>
    <form method="dialog">
      <button>Close</button>
    </form>
  </div>
  <p class="now">
    <span class="temp">{weather.temperature}°</span>
    {weather.condition}
    {weather.low !== undefined && weather.high !== undefined && `, ${weather.low}° to ${weather.high}°`}
    {!!weather.rain && `, ${weather.rain} mm rain`}
  </p>
  <dl class="facts">
    <div>
      <dt>Wind</dt>
      <dd>
        {weather.wind} km/h from the {weather.windFrom}
      </dd>
    </div>
    <div>
      <dt>Humidity</dt>
      <dd>{weather.humidity}%</dd>
    </div>
    <div>
      <dt>UV index</dt>
      <dd>{weather.uv}</dd>
    </div>
    {weather.sun?.map((s) => (
      <div>
        <dt>{s.label}</dt>
        <dd>{format(s.at, { hour: "2-digit", minute: "2-digit", hourCycle: "h23" })}</dd>
      </div>
    ))}
  </dl>
  {weather.hours.length > 0 && (
    <>
      <h3>Next 12 hours</h3>
      <ol class="hours">
        {weather.hours.map((h) => (
          <li>
            <span class="hour">{format(h.at, { hour: "2-digit", minute: "2-digit", hourCycle: "h23" })}</span>
            <strong>{h.temperature}°</strong>
            <span class="rain" style={`--share:${h.share}`} aria-hidden="true" />
            <small>{h.rain > 0 ? `${h.rain} mm` : "Dry"}</small>
          </li>
        ))}
      </ol>
    </>
  )}
  {weather.days.length > 0 && (
    <>
      <h3>Next {weather.days.length} days</h3>
      <ol class="forecast">
        {weather.days.map((d, i) => (
          <li>
            <strong>{i === 0 ? "Tomorrow" : format(d.at, { weekday: "long" })}</strong>
            <span>{d.condition}</span>
            <span>{d.low !== undefined ? `${d.low}° to ${d.high}°` : `Up to ${d.high}°`}</span>
            <small>{d.rain ? `${d.rain} mm rain` : "Dry"}</small>
          </li>
        ))}
      </ol>
    </>
  )}
</dialog>

<style>
  .weather-details {
    width: min(92vw, 900px);
    padding: 1.5rem;
    border: 0;
    border-radius: 20px;
    background: var(--paper);
    color: var(--ink);
  }

  .weather-details::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .head h2 {
    font-size: 1.125rem;
    font-family: var(--body);
    color: var(--muted);
  }

  .weather-details .now {
    margin: 0.5rem 0 1.25rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 0 0 1.5rem;
  }

  .facts dt {
    color: var(--muted);
    font-size: 1rem;
  }

  .facts dd {
    margin: 0;
    font-weight: 700;
  }

  .weather-details h3 {
    font-size: 1.125rem;
    font-family: var(--body);
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .hours {
    display: grid;
    grid-template-columns: repeat(12, minmax(3.25rem, 1fr));
    gap: 0;
    margin: 0;
    padding: 0 0 0.25rem;
    list-style: none;
    overflow-x: auto;
    text-align: center;
  }

  .hours li {
    display: grid;
    grid-template-rows: auto auto 3.5rem auto;
    justify-items: center;
    gap: 0.3rem;
  }

  .hours .hour,
  .hours small {
    color: var(--muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .hours strong {
    font-family: var(--display);
    font-size: 1.5rem;
  }

  .hours .rain {
    align-self: end;
    width: 1.25rem;
    height: max(3px, calc(var(--share) * 100%));
    border-radius: 4px 4px 0 0;
    background: var(--lake);
  }

  .forecast {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .forecast li {
    display: grid;
    gap: 0.2rem;
  }

  .forecast small {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .head button {
    padding: 0.7rem 1.2rem;
    border: 0;
    border-radius: 12px;
    background: var(--lake);
    color: var(--paper);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .temp {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.6em;
    margin-right: 0.35rem;
  }
</style>
