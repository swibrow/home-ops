---
import "./panel.css";

type Props = { cameras: string[] };
const { cameras } = Astro.props;
const label = (camera: string) => camera.charAt(0).toUpperCase() + camera.slice(1).replaceAll("_", " ");
---

<section class="panel cameras" aria-labelledby="cameras-heading">
  <h2 id="cameras-heading">Cameras</h2>
  <div class="feeds">
    {
      cameras.map((camera) => (
        <button type="button" class="feed" data-view={camera} data-label={label(camera)} aria-label={`Show the ${label(camera).toLowerCase()} camera full screen`}>
          <video data-camera={`${camera}_sub`} muted playsinline autoplay />
          <span>{label(camera)}</span>
        </button>
      ))
    }
  </div>
</section>

<style>
  .cameras {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .feeds {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    grid-auto-rows: minmax(8rem, 1fr);
    gap: 0.6rem;
    overflow-y: auto;
  }

  .feed {
    position: relative;
    min-height: 0;
    padding: 0;
    border: 0;
    cursor: pointer;
    border-radius: 14px;
    overflow: hidden;
    background: var(--panel);
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feed span {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-size: 0.9rem;
  }
</style>
