---
import "./panel.css";

type Props = { items: { uid: string; summary: string }[] };
const { items } = Astro.props;
---

<section class="panel shopping" aria-labelledby="shopping-heading">
  <h2 id="shopping-heading">Shopping list</h2>
  {
    items.length ? (
      <ul class="items">
        {items.map((item) => (
          <li>
            <button type="button" class="item" data-done={item.uid}>
              <span class="box" aria-hidden="true" />
              {item.summary}
            </button>
          </li>
        ))}
      </ul>
    ) : (
      <p class="quiet">The list is empty.</p>
    )
  }
  <form class="add" data-shopping>
    <label class="visually-hidden" for="add-item">Add to the shopping list</label>
    <input id="add-item" name="add" autocomplete="off" placeholder="Add something…" maxlength="100" />
    <button type="submit">Add</button>
  </form>
</section>

<style>
  .items {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    columns: 2 10rem;
    column-gap: 1rem;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    break-inside: avoid;
  }

  .box {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 6px;
    box-shadow: inset 0 0 0 2px var(--muted);
  }

  .item.done {
    color: var(--muted);
    text-decoration: line-through;
  }

  .item.done .box {
    background: var(--moss);
    box-shadow: none;
  }

  .add {
    display: flex;
    gap: 0.5rem;
  }

  .add input {
    flex: 1;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }

  .add button {
    padding: 0.7rem 1.2rem;
    border: 0;
    border-radius: 12px;
    background: var(--lake);
    color: var(--paper);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
</style>
