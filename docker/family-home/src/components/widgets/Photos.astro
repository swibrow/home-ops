---
import "./panel.css";

type Props = { photos: { id: string; year: number }[] };
const { photos } = Astro.props;
// Picked by the clock so the minutely page refresh carries on where the slideshow was.
const start = Math.floor(Date.now() / 15_000) % photos.length;
---

<section class="panel photos" aria-labelledby="photos-heading">
  <h2 id="photos-heading">On this day</h2>
  <div class="frame" data-photos>
    {
      photos.map((p, i) => (
        <figure class:list={{ shown: i === start }}>
          <img src={`/kitchen/api/photo/${p.id}`} alt={`Photo from ${p.year}`} />
          <figcaption>{p.year}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .photos {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .frame {
    position: relative;
    flex: 1;
    min-height: 12rem;
    border-radius: 18px;
    overflow: hidden;
    background: var(--panel);
  }

  figure {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  figure.shown {
    opacity: 1;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: rgb(12 20 34 / 0.55);
    color: #f4f7f8;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    figure {
      transition: none;
    }
  }
</style>

<script>
  // The #live refresh swaps the frame out every minute, so look it up on each tick.
  setInterval(() => {
    const frame = document.querySelector("[data-photos]");
    const shown = frame?.querySelector(".shown");
    if (!frame || !shown) return;
    shown.classList.remove("shown");
    (shown.nextElementSibling ?? frame.firstElementChild)!.classList.add("shown");
  }, 15_000);
</script>
