{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/linuxserver/calibre-web"],
      allowedVersions: "<1",
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["tomsquest/docker-radicale"],
      allowedVersions: "/^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$/",
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/kopia/kopia"],
      allowedVersions: "<999",
    },
    {
      // Stale kgateway-era v2.2.x tags that outrank the current v1.x line.
      // https://github.com/agentgateway/agentgateway/issues/3457
      matchDatasources: ["docker"],
      matchPackageNames: ["cr.agentgateway.dev/charts/**"],
      allowedVersions: "!/^v?2\\.2\\./",
    },
    {
      // Open-WebUI's web loader client pins python playwright exactly and
      // refuses a server of any other version. Bump by hand together with
      // Open-WebUI's requirements.txt pin (apps/pitower/ai/playwright).
      // Does not cover mcr.microsoft.com/playwright/mcp.
      matchDatasources: ["docker"],
      matchPackageNames: ["mcr.microsoft.com/playwright"],
      enabled: false,
    },
    {
      // browser-use v3.0.0 pins langchain-ibm==0.3.10, which requires Python <3.13.
      matchDatasources: ["docker"],
      matchFileNames: ["docker/browser-use/Dockerfile"],
      matchPackageNames: ["python"],
      allowedVersions: "<3.13",
    },
  ],
}
